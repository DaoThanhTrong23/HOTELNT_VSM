# Base API URL của Backend
VITE_API_BASE_URL=https://api.hotelnt.com/api/v1

# Tích hợp dịch vụ bên thứ 3
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_ZALO_APP_ID=your_zalo_app_id_here

# Dùng dữ liệu mock (src/mocks) khi chưa có backend. Đặt false để gọi API thật.
VITE_USE_MOCK=false
